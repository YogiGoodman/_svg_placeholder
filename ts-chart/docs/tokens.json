{
  "$description": "TS Chart design tokens. Single source of truth for the theme. Consume via CSS custom properties (--ts-*). Dark is default; light remaps the same names.",
  "meta": { "name": "TS Chart", "version": "0.1.0" },
  "color": {
    "dark": {
      "bg": "#0d0f12",
      "bgElevated": "#12151a",
      "bgInset": "#0a0c0f",
      "bgHover": "#191d23",
      "bgActive": "#20252c",
      "bgScrim": "rgba(8, 9, 11, 0.62)",
      "border": "#252a31",
      "borderStrong": "#333a43",
      "borderSubtle": "#1b1f25",
      "gridStrong": "#1d2127",
      "gridWeak": "#16191e",
      "text": "#d7dde4",
      "textBright": "#f3f6f9",
      "textSecondary": "#aeb7c1",
      "textMuted": "#8b96a3",
      "textFaint": "#59636e",
      "accent": "#3fb6f0",
      "accentStrong": "#5cc4f5",
      "accentWeak": "rgba(63, 182, 240, 0.14)",
      "accentContrast": "#06121b",
      "highlight": "#f5a623",
      "highlightContrast": "#0d0f12",
      "up": "#26c281",
      "down": "#ef5f6b",
      "warn": "#f5a623"
    },
    "light": {
      "bg": "#f5f7fa",
      "bgElevated": "#ffffff",
      "bgInset": "#eef1f6",
      "bgHover": "#eef2f7",
      "bgActive": "#e3ecf6",
      "bgScrim": "rgba(15, 23, 32, 0.32)",
      "border": "#dbe2ea",
      "borderStrong": "#c3cedb",
      "borderSubtle": "#e8edf3",
      "gridStrong": "#e5eaf1",
      "gridWeak": "#eef2f7",
      "text": "#26313f",
      "textBright": "#0c1219",
      "textSecondary": "#455163",
      "textMuted": "#6b7787",
      "textFaint": "#a9b3c0",
      "accent": "#1f8fd0",
      "accentStrong": "#1478b4",
      "accentWeak": "rgba(31, 143, 208, 0.12)",
      "accentContrast": "#ffffff",
      "highlight": "#d9861a",
      "highlightContrast": "#ffffff",
      "up": "#10a56a",
      "down": "#e0384a",
      "warn": "#f5a623"
    }
  },
  "seriesPalette": {
    "blue": "#3fb6f0", "amber": "#f5a623", "green": "#26c281", "red": "#ef5f6b",
    "purple": "#a78bfa", "teal": "#2dd4bf", "pink": "#f472b6", "orange": "#fb923c",
    "lime": "#a3e635", "cyan": "#22d3ee", "gold": "#e6c14b", "slate": "#8fa1b6"
  },
  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px" },
  "radius": { "xs": "4px", "sm": "6px", "md": "8px", "lg": "12px", "xl": "16px", "pill": "999px" },
  "font": {
    "sans": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace"
  },
  "fontSize": { "xxs": "10px", "xs": "11px", "sm": "12px", "md": "13px", "base": "14px", "lg": "16px", "xl": "20px", "2xl": "26px" },
  "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
  "lineHeight": { "tight": 1.2, "normal": 1.45 },
  "motion": {
    "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "dur1": "120ms", "dur2": "180ms", "dur3": "240ms"
  },
  "shadow": {
    "dark": { "1": "0 1px 2px rgba(0,0,0,.4)", "2": "0 4px 16px rgba(0,0,0,.45)", "3": "0 12px 40px rgba(0,0,0,.55)" },
    "light": { "1": "0 1px 2px rgba(15,23,32,.08)", "2": "0 6px 20px rgba(15,23,32,.12)", "3": "0 16px 44px rgba(15,23,32,.18)" }
  }
}
